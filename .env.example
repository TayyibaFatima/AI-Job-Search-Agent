# Copy this file to .env and fill in your own values. Never commit .env.

# Adzuna job search API  -> https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# Jooble job search API  -> free key by request: https://jooble.org/api/about
# (optional - only needed for the "Jooble" and "All sources" options)
JOOBLE_API_KEY=

# Groq LLM API           -> https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# PostgreSQL (used for LangGraph checkpoints + search history)
DATABASE_URL=postgresql://user:password@localhost:5432/jobagent

# --- Optional tuning -------------------------------------------------------
# Fetch the full listing text instead of Adzuna's short preview (recommended)
ENRICH_DESCRIPTIONS=true
ENRICH_TIMEOUT_SECONDS=8
ENRICH_MAX_WORKERS=5
# Let the LLM add extra grounded skills on top of the deterministic extractor
USE_LLM_JOB_ANALYSIS=true
ANALYSIS_CACHE_PATH=.cache/job_analysis.json
# Remotive asks for infrequent requests, so results are cached this long
REMOTIVE_CACHE_HOURS=6
